# Local development only — copy to compose/.env
# and fill in real local values.

ENVIRONMENT="development"
SERVER_PORT=8080

JWT_SECRET=change-me

POSTGRES_DB="postgres"
POSTGRES_HOST="127.0.0.1"
POSTGRES_PORT=5432
POSTGRES_USER="postgres"
POSTGRES_PASS="change-me"

DB_HOST_APP="localhost"
DB_PORT_APP=5432
DB_PASS_APP="change-me"
DB_NAME_APP="bliki"
DB_USER_APP="bliki_app"
DB_SCHEMA_APP="bliki"
DB_DEFAULT_DATABASE_APP=true
DB_CONNECTION_POOL_SIZE_APP=16

DB_HOST_ADMIN="localhost"
DB_PORT_ADMIN=5432
DB_PASS_ADMIN="change-me"
DB_NAME_ADMIN="bliki"
DB_USER_ADMIN="bliki_admin"
DB_SCHEMA_ADMIN="bliki"
DB_DEFAULT_DATABASE_ADMIN=false
DB_CONNECTION_POOL_SIZE_ADMIN=8

DB_ISOLATION_LEVEL="TRANSACTION_READ_COMMITTED"
DB_MAX_LIFETIME=1800000
DB_TYPE="postgresql"
DB_AUTO_COMMIT=true
DB_LEAK_DETECTION_THRESHOLD=120000

VALKEY_PASSWORD="change-me"
VALKEY_PORT=6379
VALKEY_URL="valkey://valkey:${VALKEY_PORT}"
